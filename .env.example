# Copie para .env e preencha. O .env nunca vai para o Git.

# String de conexão do Neon. Localmente, use SEMPRE a do branch dev.
# A de produção fica apenas nos GitHub Secrets.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# "dev" libera os testes de banco (pytest). Qualquer outro valor faz com que sejam pulados.
# Só defina "dev" se a DATABASE_URL acima for do branch dev.
AMBIENTE=dev

# Opcionais
# LOG_LEVEL=INFO
# CONFIG_PATH=config/instituicoes.yaml
